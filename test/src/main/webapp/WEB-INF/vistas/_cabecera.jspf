<%@page pageEncoding="UTF-8"%>
<%@taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%>
<%@taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt"%>
<fmt:setLocale value="es_ES" scope="request"/>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<header class="barra">
    <div class="marca">SENADM <span>Matriz de Riesgos y Brechas</span></div>
    <nav>
        <a href="${ctx}/app/inicio" class="${seccion == 'dashboard' ? 'activo' : ''}">Dashboard</a>
        <a href="${ctx}/app/riesgos" class="${seccion == 'matriz' ? 'activo' : ''}">Matriz Operativa</a>
        <a href="${ctx}/app/riesgos?accion=nuevo" class="${seccion == 'nuevo' ? 'activo' : ''}">Nuevo riesgo</a>
        <a href="${ctx}/app/parametrizacion" class="${seccion == 'param' ? 'activo' : ''}">Parametrización</a>
    </nav>
    <div class="usuario">
        <c:out value="${sessionScope.usuario}"/>
        <a href="${ctx}/logout">Cerrar sesión</a>
    </div>
</header>
<c:if test="${not empty sessionScope.mensaje}">
    <div class="aviso"><c:out value="${sessionScope.mensaje}"/></div>
    <c:remove var="mensaje" scope="session"/>
</c:if>
