<%@page pageEncoding="UTF-8"%>
<%@taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%>
<%@taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt"%>
<%@taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions"%>
<fmt:setLocale value="es_ES" scope="request"/>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<c:set var="nombreUsuario" value="${sessionScope.usuario}"/>
<header class="barra">
    <a class="marca" href="${ctx}/app/inicio">
        <span class="marca-logo" aria-hidden="true">S</span>
        <span class="marca-texto">
            <strong>SENADI</strong>
            <small>Matriz de Riesgos y Brechas</small>
        </span>
    </a>
    <nav aria-label="Principal">
        <a href="${ctx}/app/inicio" class="${seccion == 'dashboard' ? 'activo' : ''}">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/></svg>
            Dashboard
        </a>
        <a href="${ctx}/app/riesgos" class="${seccion == 'matriz' ? 'activo' : ''}">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M3 15h18M9 3v18"/></svg>
            Matriz Operativa
        </a>
        <a href="${ctx}/app/riesgos?accion=nuevo" class="${seccion == 'nuevo' ? 'activo' : ''}">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8v8M8 12h8"/></svg>
            Nuevo riesgo
        </a>
        <a href="${ctx}/app/parametrizacion" class="${seccion == 'param' ? 'activo' : ''}">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12M20 18h0"/><circle cx="16" cy="6" r="2"/><circle cx="10" cy="12" r="2"/><circle cx="18" cy="18" r="2"/></svg>
            Parametrización
        </a>
    </nav>
    <div class="usuario">
        <span class="avatar" aria-hidden="true"><c:out value="${fn:toUpperCase(fn:substring(nombreUsuario, 0, 1))}"/></span>
        <span class="usuario-datos">
            <small>Sesión iniciada</small>
            <strong><c:out value="${nombreUsuario}"/></strong>
        </span>
        <a class="salir" href="${ctx}/logout" title="Cerrar sesión">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 4h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-3M10 17l5-5-5-5M15 12H4"/></svg>
            <span>Salir</span>
        </a>
    </div>
</header>
<c:if test="${not empty sessionScope.mensaje}">
    <div class="aviso"><c:out value="${sessionScope.mensaje}"/></div>
    <c:remove var="mensaje" scope="session"/>
</c:if>
<script>
    // Si el navegador restaura la página desde su caché de "Atrás/Adelante" (bfcache),
    // se recarga para mostrar siempre los datos actuales de la base.
    window.addEventListener('pageshow', function (e) {
        if (e.persisted) {
            location.reload();
        }
    });
</script>
